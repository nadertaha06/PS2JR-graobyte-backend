# MongoDB
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/<database>

# JWT
JWT_SECRET_KEY=sua_chave_secreta_aqui

# CORS — separe múltiplas origens por vírgula (ex: http://localhost:3000,https://seusite.com)
CORS_ORIGINS=http://localhost:3000

# Flask — defina como "true" apenas em desenvolvimento
FLASK_DEBUG=false
